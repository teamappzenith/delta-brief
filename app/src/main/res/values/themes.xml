<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.DeltaBrief" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/slate_primary</item>
        <item name="colorPrimaryVariant">@color/slate_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/trading_blue</item>
        <item name="colorSecondaryVariant">@color/trading_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/slate_dark</item>
        <!-- Window background -->
        <item name="android:windowBackground">@color/slate_light</item>
    </style>
</resources>
